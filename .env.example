# ERPNext API Configuration
# Copy this file to .env and fill in your actual credentials
# The .env file is gitignored for security

# ERPNext Instance URL (without trailing slash)
ERPNEXT_API_URL=https://erp.kartoza.com

# API Key and Secret for ERPNext authentication
# Generate these in ERPNext: User Menu > API Access > Generate Keys
ERPNEXT_API_KEY=your_api_key_here
ERPNEXT_API_SECRET=your_api_secret_here

# Optional: Hugo environment
# HUGO_ENV=production

# Site-wide kill-switch for course booking/purchasing.
# When true, every training course page shows the message below instead of
# the booking widget. Picked up by `make serve` / `make build` and mapped by
# Hugo to site.Params.coursepurchasedisabled / coursepurchasedisabledmessage.
HUGO_PARAMS_COURSEPURCHASEDISABLED=false
HUGO_PARAMS_COURSEPURCHASEDISABLEDMESSAGE="Course bookings are temporarily unavailable. Please contact seabilwe@kartoza.com to enquire about this course."
